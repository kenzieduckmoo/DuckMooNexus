{
  "uid": "duckmoo-warband-inventory",
  "title": "DuckMoo Nexus | Warband Inventory",
  "description": "Search cached item names across characters, the Warbank and guild banks. Individual item observation times are unavailable.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "DuckMoo Nexus"
  ],
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "duckmoo-postgres"
        },
        "query": "SELECT DISTINCT namespace FROM nexus.imports UNION SELECT DISTINCT namespace FROM nexus.source_snapshots",
        "current": {
          "text": "retail-main-account",
          "value": "retail-main-account"
        },
        "refresh": 1
      },
      {
        "name": "item_search",
        "label": "Item name or ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "owner",
        "label": "Owner",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "duckmoo-postgres"
        },
        "query": "SELECT DISTINCT owner_kind||': '||owner_key AS __text,owner_kind||':'||owner_key AS __value FROM nexus.current_inventory WHERE namespace=${account:sqlstring} ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "duckmoo-postgres"
        },
        "query": "SELECT DISTINCT location FROM nexus.current_inventory WHERE namespace=${account:sqlstring} ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
