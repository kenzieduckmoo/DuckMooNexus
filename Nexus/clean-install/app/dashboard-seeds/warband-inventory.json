      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "duckmoo-postgres"
          },
          "rawSql": "SELECT name AS item,crafting_quality AS crafting_rank,\n       owner_kind,owner_key AS owner,location,quantity,is_bound,rarity,item_id,snapshot_file_saved_at FROM nexus.inventory_totals WHERE namespace=${account:sqlstring}\n      AND (strpos(lower(coalesce(name,'')),lower(${item_search:sqlstring}))>0 OR item_id::text=${item_search:sqlstring})\n      AND owner_kind||':'||owner_key IN (${owner:sqlstring}) AND location IN (${location:sqlstring})\n       ORDER BY name,crafting_quality NULLS LAST,owner_kind,owner_key,location LIMIT 1000",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {}
