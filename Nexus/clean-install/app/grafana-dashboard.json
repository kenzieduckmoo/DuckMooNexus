{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Existing PostgreSQL data source",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "uid": "duckmoo-journalator-mvp",
  "title": "DuckMoo Nexus \u2014 Journalator MVP",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "tags": [
    "DuckMoo",
    "Journalator"
  ],
  "description": "Recorded auction trade net is not profit or a wallet balance. Purchases are negative; sales deduct recorded AH commission. Deposits, inventory value, crafting inputs, and other activity are excluded. Data is a SavedVariables snapshot.",
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account namespace",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT namespace FROM nexus.imports ORDER BY 1",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Auction trade net (gold; excludes deposits and inventory cost)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(trade_net_copper),0)/10000.0 AS gold FROM nexus.auction_invoices WHERE namespace = ${account:sqlstring} AND $__timeFilter(occurred_at)",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Recorded events",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS events FROM nexus.transactions WHERE namespace = ${account:sqlstring} AND $__timeFilter(occurred_at)",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Daily auction trade net (UTC)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day',occurred_at AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS time, sum(trade_net_copper)/10000.0 AS gold FROM nexus.auction_invoices WHERE namespace = ${account:sqlstring} AND $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Auction activity by character",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT character,realm,count(*) AS invoices,sum(trade_net_copper)/10000.0 AS trade_net_gold FROM nexus.auction_invoices WHERE namespace = ${account:sqlstring} AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 4 DESC",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Record coverage",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT category,count(*) AS records FROM nexus.transactions WHERE namespace = ${account:sqlstring} AND $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 2 DESC",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Import provenance (all dates)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT imported_at,filename,sha256,importer_version FROM nexus.imports WHERE namespace=${account:sqlstring} ORDER BY imported_at DESC LIMIT 20",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}