[Unit]
Description=DuckMoo Nexus private Journalator import worker
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/duckmoo-sync/worker.py
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/duckmoo-sync
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
